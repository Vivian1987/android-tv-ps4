# Release source repository: generated and machine-local artifacts stay outside Git.
*
!*/
!/*.py
!/.gitignore
!/README.md
!/installer/**/*.py
!/installer/**/*.c
!/installer/**/*.h
!/installer/**/LICENSE*
!/installer/**/*LICENSE.txt
!/ramboot/**/*.py
!/ramboot/**/*.c
!/ramboot/**/*.h
!/ramboot/**/*.sh
!/patches/**/*.py
!/patches/**/*.patch
!/probe/**/*.py
!/probe/**/*.c
!/probe/**/*.h
__pycache__/
*.private.*
installer-artwork.h
installer-font.h

/reference/
/downloads/
/android-system/
/evidence/
/checkpoints/
/host/

!/docs/BUILD.md
!/docs/ASSETS.md
!/ramboot/init
!/branding/selected.json
!/branding/official-asset-sources.json
!/branding/refine-layout.py
!/branding/android-tv-official.png
!/branding/ps4-official.png
!/branding/*-official-assets-v6.png
!/branding/*-official-assets-v6.svg
!/installer/sparse-v014/source/installer-artwork.h
!/installer/sparse-v014/source/installer-font.h

!/branding/repository-banner.svg
!/installer/README.md

!/releases/v015/artwork/*.py
!/releases/v015/artwork/*.png
!/releases/v015/artwork/*.svg
!/releases/v015/artwork/official-asset-sources.json

!/releases/v015/source/*
!/releases/v015/build-release.py
!/releases/v015/image-metadata.h
!/releases/v015/power/android-supervisor.c
!/releases/v015/power/README.md
!/releases/v015/tests/*.py
!/releases/v015/tests/*.c

!/docs/STORAGE.md
