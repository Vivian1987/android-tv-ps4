#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
exec </dev/console >/dev/console 2>&1
hostname cole-ps4
echo 'Cole PS4 Android project: RAM diagnostic boot'
echo 'Internal disks are not mounted. No installer is running.'
echo 7 > /proc/sys/kernel/printk
mdev -s
quota_module=/lib/modules/$(uname -r)/extra/xt_quota2.ko
if [ -f "$quota_module" ]; then
    insmod "$quota_module" || echo 'Android quota2 module failed to load'
fi
ip link set lo up
network_ready=0
for attempt in $(seq 1 30); do
    for item in /sys/class/net/*; do
        iface=${item##*/}
        [ "$iface" = lo ] && continue
        # Virtual dummy/veth devices are Ethernet-like too; require real hardware.
        [ -e "$item/device" ] || continue
        [ -d "$item/wireless" ] && continue
        [ "$(cat "$item/type")" = 1 ] || continue
        ip link set "$iface" up || continue
        ip addr replace 192.168.0.77/24 dev "$iface" || continue
        echo "Wired management: $iface at 192.168.0.77 (no internet route)"
        network_ready=1
        break
    done
    [ "$network_ready" = 1 ] && break
    sleep 1
done
mkdir -p /run/cole
uname -a > /run/cole/uname.txt
cat /proc/cmdline > /run/cole/cmdline.txt
cat /proc/meminfo > /run/cole/meminfo.txt
cat /proc/partitions > /run/cole/partitions.txt
ip addr > /run/cole/network.txt
dmesg > /run/cole/dmesg.txt
for d in /sys/bus/pci/devices/*; do
    echo "$d $(cat "$d/vendor") $(cat "$d/device") $(cat "$d/class")"
done > /run/cole/pci.txt
/usr/sbin/dropbear -F -E -s -j -k -p 192.168.0.77:22 \
    -r /etc/dropbear/host_ed25519 >/run/cole/dropbear.log 2>&1 &
echo 'SSH uses the project key only; password login and forwarding are disabled.'
echo 'Reports are in /run/cole. Reboot returns to the PS4 operating system.'
while :; do
    setsid cttyhack /bin/sh
    sleep 1
done
