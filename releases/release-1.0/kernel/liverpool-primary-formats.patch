 #include "amdgpu.h"
 #include "amdgpu_pm.h"
@@ -2653,16 +2654,68 @@ static const struct drm_plane_helper_funcs dce_v8_0_drm_primary_plane_helper_fun
 	.panic_flush = dce_v8_0_panic_flush,
