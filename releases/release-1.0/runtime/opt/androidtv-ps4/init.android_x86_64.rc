on early-init
    export MESA_GLES_VERSION_OVERRIDE 3.2
	export MESA_EXTENSION_OVERRIDE "
    GL_OES_EGL_image
    GL_OES_EGL_image_external
    GL_OES_depth24
    GL_OES_depth32
    GL_OES_element_index_uint
    GL_OES_texture_float
    GL_OES_texture_float_linear
    GL_OES_compressed_paletted_texture
    GL_OES_compressed_ETC1_RGB8_texture
    GL_OES_depth_texture
    GL_EXT_texture_format_BGRA8888
    GL_APPLE_texture_format_BGRA8888
    GL_OES_texture_half_float
    GL_OES_texture_half_float_linear
    GL_OES_packed_depth_stencil
    GL_OES_vertex_half_float
    GL_OES_texture_npot
    GL_OES_rgb8_rgba8
    GL_EXT_color_buffer_float
    GL_EXT_color_buffer_half_float
    GL_EXT_robustness
    GL_OES_EGL_image_external_essl3
    GL_OES_vertex_array_object
    GL_OES_texture_compression_astc
    GL_KHR_texture_compression_astc_hdr
    GL_KHR_texture_compression_astc_ldr
    GL_OES_EGL_sync
    GL_EXT_copy_image
    GL_EXT_shader_texture_lod
    GL_EXT_texture_filter_anisotropic
    GL_OES_standard_derivatives
    GL_EXT_blend_minmax
    GL_EXT_debug_marker
    GL_OES_surfaceless_context
    GL_EXT_texture_type_2_10_10_10_REV
    GL_EXT_read_format_bgra
    GL_EXT_sRGB
    GL_KHR_blend_equation_advanced
    glGetErrorReturnSuccessAlways
    eglCreateContext3ForceTo2
	"
on boot
    resetprop ro.bootloader mustang
    setprop ro.bootloader mustang
	setprop ro.boot.bootloader mustang
	setprop ro.build.expect.bootloader mustang
    setprop ro.boot.hardware.revision MP1.0
    setprop ro.boot.hardware.sku mustang
	setprop ro.boot.verifiedbootstate green
	setprop ro.boot.hwname mustang
    setprop ro.boot.hwdevice mustang
    setprop ro.product.hardware.sku mustang
    setprop ro.boot.product.hardware.sku mustang
	setprop ro.build.device_family FL5BZ5MT5RG5
	setprop ro.quick_start.oem_id 00e0
    setprop ro.quick_start.device_id mustang
	setprop persist.sys.usb.config adb
    setprop persist.service.adb.enable 1
    setprop service.adb.tcp.port 5555
    setprop persist.adb.tcp.port 5555
	enable_nativebridge
	setprop persist.sys.nativebridge 1
	setprop ro.dalvik.vm.native.bridge libhoudini.so
	setprop dalvik.vm.houdini on
	setprop ro.bionic.arch x86_64
    setprop ro.bionic.cpu_variant generic
    setprop ro.bionic.2nd_arch x86
    setprop ro.bionic.2nd_cpu_variant generic
	setprop dalvik.vm.isa.arm.variant generic
    setprop dalvik.vm.isa.arm.features default
    setprop dalvik.vm.isa.arm64.variant generic
    setprop dalvik.vm.isa.arm64.features default
    setprop dalvik.vm.isa.x86_64.variant x86_64
    setprop dalvik.vm.isa.x86_64.features default
    setprop dalvik.vm.isa.x86.variant x86_64
    setprop dalvik.vm.isa.x86.features default
	setprop ro.dalvik.vm.isa.arm x86
    setprop ro.enable.native.bridge.exec 1
    setprop ro.dalvik.vm.isa.arm64 x86_64
    setprop ro.enable.native.bridge.exec64 1
    setprop ro.zygote.disable_gl_preload true
    setprop ro.bq.gpu_to_cpu_unsupported 1
    setprop gsm.version.baseband BRTDTVisTheBestROM
    setprop ro.baseband BRTDTVisTheBestROM
	setprop ro.build.expect.baseband BRTDTVisTheBestROM
	

	
service block /system/bin/sh /vendor/brtdtv/block.sh
    class late_start
    user root
    oneshot

on property:sys.boot_completed=1
    start block

# Developer access is enabled; each host must be authorized on this device.
on property:sys.boot_completed=1
    setprop service.adb.tcp.port 5555
    start adbd

# Start authorized developer access before the setup wizard or animation.
on post-fs-data
    setprop service.adb.tcp.port 5555
    start adbd
